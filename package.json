{
  "name": "theatre-sound-mixer",
  "version": "1.7.0",
  "description": "Professional sound mixer for theatre productions - Concert Audio System (CAS)",
  "desktopName": "concert-audio-system",
  "main": "main.js",
  "author": "Concert Audio System",
  "scripts": {
    "postinstall": "node scripts/copy-assets.js",
    "start": "electron .",
    "build": "npm run build:win",
    "build-win": "electron-builder --win --dir --x64",
    "build-installer": "npm run build:win",
    "build-simple": "electron-builder --win --dir --x64",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:mac": "electron-builder --mac dmg --universal --publish never",
    "build:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.js",
    "prepare:online": "node scripts/prepare-online-tools.js",
    "check:online": "node scripts/check-online-tools.js"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "electron": "^43.8.4",
    "electron-builder": "^26.15.3",
    "howler": "^2.2.4"
  },
  "dependencies": {
    "lucide": "^1.66.0",
    "music-metadata": "^11.16.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.concertaudiosystem.cas",
    "productName": "Concert Audio System",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "workspaces.js",
      "metadata-worker.js",
      "index.html",
      "styles.css",
      "welcome.html",
      "welcome.js",
      "welcome.css",
      "assets/app-icon.ico",
      "assets/app-icon.png",
      "assets/big-logo.png",
      "assets/cas-logo-transparent.png",
      "assets/howler.min.js",
      "assets/lucide.min.js",
      "assets/fontawesome/**/*",
      "online-music.js",
      "online-ui.js",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "console.css",
      "assets/fonts/**/*",
      "remote-server.js",
      "qr-generator.js",
      "remote-client/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/app-icon.ico",
      "artifactName": "Concert-Audio-System-Setup.${ext}"
    },
    "mac": {
      "icon": "assets/app-icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music",
      "artifactName": "Concert-Audio-System-macOS.${ext}",
      "x64ArchFiles": "**/online-tools/darwin-*/{deno,ffmpeg}"
    },
    "linux": {
      "icon": "assets/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo;Audio;Player;",
      "maintainer": "Concert Audio System",
      "syncDesktopName": true,
      "artifactName": "Concert-Audio-System-linux.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Concert Audio System",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "Audio",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "unicode": true
    },
    "compression": "normal",
    "asar": true,
    "electronDownload": {
      "cache": ".electron-cache"
    },
    "extraResources": [
      {
        "from": "tools",
        "to": "online-tools",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "license": "MIT"
}
