{
  "name": "theatre-sound-mixer",
  "version": "1.1.3",
  "description": "Professional sound mixer for theatre productions - Concert Audio System (CAS)",
  "main": "main.js",
  "author": "Concert Audio System",
  "scripts": {
    "postinstall": "node scripts/copy-assets.js",
    "start": "electron .",
    "build": "electron-builder --win nsis --x64",
    "build-win": "electron-builder --win --dir --x64",
    "build-installer": "electron-builder --win nsis --x64",
    "build-simple": "electron-builder --win --dir --x64",
    "dev": "electron . --dev"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "howler": "^2.2.4"
  },
  "dependencies": {
    "music-metadata": "^11.13.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.concertaudiosystem.cas",
    "productName": "Concert Audio System",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "metadata-worker.js",
      "index.html",
      "styles.css",
      "welcome.html",
      "welcome.js",
      "welcome.css",
      "assets/app-icon.ico",
      "assets/big-logo.png",
      "assets/howler.min.js",
      "assets/fontawesome/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false,
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Concert Audio System",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "Audio",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "unicode": true
    },
    "artifactName": "Concert-Audio-System-Setup.${ext}",
    "compression": "normal",
    "asar": true,
    "electronDownload": {
      "cache": ".electron-cache"
    }
  },
  "license": "MIT"
}
